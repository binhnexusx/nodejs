<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In</title>
    <link rel="stylesheet" href="/css/sign_in.css">
</head>

<body>
    <div class="background">
        <div class="auth-container">
            <div class="auth-form">
                <h2 class="sign-in-title">Sign In</h2>

                <form class="sign-in-form">
                    <div class="input-group">
                        <img src="/icons/user.png" class="input-icon" alt="User Icon">
                        <input type="text" class="input-field" placeholder="Enter Username">
                    </div>
                    <div class="input-group">
                        <img src="/icons/password.png" class="input-icon" alt="Lock Icon">
                        <input type="password" class="input-field" placeholder="Enter Password">
                    </div>

                    <div class="remember-me">
                        <input type="checkbox" id="remember">
                        <label for="remember">Remember Me</label>
                    </div>

                    <button class="btn btn-primary">Login</button>

                    <div class="social-login">
                        <p>Or, Login with</p>
                        <div class="social-icons">
                            <img src="/icons/fb.png" alt="Facebook">
                            <img src="/icons/Gg.png" alt="Google">
                            <img src="/icons/X.png" alt="X">
                        </div>
                    </div>

                    <p class="signup-text">Don't have an account? <a href="#">Create One</a></p>
                </form>
            </div>

            <div class="auth-illustration">
                <img src="/images/Illustration.png" alt="Illustration">
            </div>
        </div>
    </div>
</body>

</html>