<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/css/sign_up.css">

<body>
    <div class="container">
        <div class="form-box">
            <div class="form-left">
                <img src="images/singup-illustration.png" alt="Sign Up Illustration">
            </div>
            <div class="form-right">
                <h2 class="sign-up-title">Sign Up</h2>
                <form>
                    <div class="input-group">
                        <img src="icons/first-name.png" class="input-icon" alt="User Icon">
                        <input type="text" placeholder="Enter First Name">
                    </div>
                    <div class="input-group">
                        <img src="icons/last-name.png" class="input-icon" alt="User Icon">
                        <input type="text" placeholder="Enter Last Name">
                    </div>
                    <div class="input-group">
                        <img src="icons/user.png" class="input-icon" alt="Username Icon">
                        <input type="text" placeholder="Enter Username">
                    </div>
                    <div class="input-group">
                        <img src="icons/email.png" class="input-icon" alt="Email Icon">
                        <input type="email" placeholder="Enter Email">
                    </div>
                    <div class="input-group">
                        <img src="icons/password.png" class="input-icon" alt="Password Icon">
                        <input type="password" placeholder="Enter Password">
                    </div>
                    <div class="input-group">
                        <img src="icons/confirm-password.png" class="input-icon" alt="Password Icon">
                        <input type="password" placeholder="Confirm Password">
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="agree">
                        <label for="agree">I agree to all terms</label>
                    </div>
                    <button class="register-btn">Register</button>
                    <p>Already have an account? <a href="sign_in">Sign In</a></p>
                </form>
            </div>
        </div>z
    </div>
</body>

</html>